# ============================================================
# MemoBento 환경변수
# ============================================================
# 로컬: 이 파일을 .env.local 로 복사하고 값을 채우세요.
# 프로덕션: Synology Container Manager 환경변수에 직접 등록.

# --- DB / 파일 저장 ---
DATABASE_PATH=./data/memobento.db
# 업로드된 이미지·PDF·파일 원본이 저장되는 디렉터리
UPLOAD_DIR=./data/uploads
# 업로드 1개당 최대 크기 (MB)
MAX_UPLOAD_MB=50

# --- MailBento 호환 (선택) ---
# MailBento 의 SQLite 파일 경로를 지정하면 시스템 메모함(Corkboard / Memo)이
# 그 DB 의 widget_state 를 직접 읽고 써서 양쪽이 실시간으로 동기화됩니다.
# 비워두면 MemoBento 자체 DB 의 widget_state 를 사용하며,
# /settings 의 불러오기로 MailBento 백업 JSON 을 가져올 수 있습니다.
# Docker 로 나란히 띄웠다면 컨테이너 내부 경로:
#   MAILBENTO_DB_PATH=/app/mailbento/mailbento.db
MAILBENTO_DB_PATH=

# MailBento 로 건너가는 헤더 버튼의 주소 (선택).
# 비우면 지금 접속한 호스트의 3000 포트로 자동 유추합니다
# (LAN / Tailscale / MagicDNS 중 무엇으로 들어왔든 그대로 따라감).
# 리버스 프록시 뒤에 두는 등 포트가 다르면 전체 URL 을 적으세요.
MAILBENTO_URL=

# --- 인증 (선택) ---
# 둘 다 비워두면 인증 비활성 (앱 그대로 공개). Tailscale 만으로 보안 충분하다면 비워둬도 OK.
#
# AUTH_PASSWORD: plaintext 또는 bcrypt 해시 ($2a$ / $2b$ 시작) 둘 다 자동 감지.
#   bcrypt 추천 — plaintext 는 누군가 .env.local 을 보면 그대로 노출됨.
AUTH_PASSWORD=
# AUTH_SECRET: 세션 쿠키 암호화 키 (32바이트 base64). 절대 외부 노출 금지.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
